{
  "expo": {
    "name": "ShoeDZ",
    "slug": "shodz",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dz.shodz.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan product barcodes"
      }
    },
    "android": {
      "package": "dz.shodz.app",
      "permissions": ["CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        { "cameraPermission": "Allow ShoeDZ to access your camera to scan barcodes." }
      ],
      [
        "expo-notifications",
        { "color": "#1e40af" }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "shodz"
  }
}
