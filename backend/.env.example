# ─────────────────────────────────────────────────────────────────
# ShoeDZ Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────

# Django
SECRET_KEY=change-this-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://shodz:shodz_dev@localhost:5432/shodz

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@shodz.dz

# Storage (leave empty to use local filesystem in dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
USE_S3=False

# Celery
CELERY_TIMEZONE=Africa/Algiers

# Superuser (used by manage.py createsuperuser --noinput during setup)
DJANGO_SUPERUSER_EMAIL=admin@shodz.dz
DJANGO_SUPERUSER_PASSWORD=Admin1234!
