# ─────────────────────────────────────────────────────────────────────────────
# ShoeDZ — Environment Variables Reference
# Copy this file to .env.prod (production) or .env (development) and fill in
# all required values before starting services.
# Lines marked REQUIRED must be set; lines marked OPTIONAL have safe defaults.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Django Core ─────────────────────────────────────────────────────────────
# REQUIRED — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-use-a-long-random-string

# REQUIRED in production — set to False
DEBUG=False

# REQUIRED — comma-separated list of domains/IPs that serve the app
# e.g. ALLOWED_HOSTS=shodz.example.com,www.shodz.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# REQUIRED — full postgres connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://shodz:shodz_dev@db:5432/shodz

# ─── PostgreSQL (used by the db service in docker-compose.prod.yml) ───────────
# REQUIRED
DB_NAME=shodz
DB_USER=shodz
DB_PASSWORD=change-me-strong-password

# ─── Redis ───────────────────────────────────────────────────────────────────
# REQUIRED — must match the password set in the redis service command
REDIS_PASSWORD=change-me-redis-password

# REQUIRED — used by Django settings for Celery broker + cache
# Format: redis://:PASSWORD@HOST:6379/DB_INDEX
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# ─── CORS ────────────────────────────────────────────────────────────────────
# REQUIRED — URL(s) of the frontend that is allowed to make cross-origin requests
# e.g. CORS_ALLOWED_ORIGINS=https://app.shodz.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Email / SMTP ────────────────────────────────────────────────────────────
# REQUIRED in production (base.py defaults to console backend for development)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@shodz.dz
EMAIL_HOST_PASSWORD=change-me-smtp-password
# Use TLS on port 587; use SSL on port 465 — set exactly one to True
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# OPTIONAL — defaults shown
DEFAULT_FROM_EMAIL=noreply@shodz.dz
SERVER_EMAIL=errors@shodz.dz
EMAIL_SUBJECT_PREFIX=[ShoeDZ]
# OPTIONAL — comma-separated "Name <email>" pairs for Django ADMINS list
# e.g. DJANGO_ADMINS=Alice <alice@example.com>,Bob <bob@example.com>
DJANGO_ADMINS=

# ─── Storage (S3 / local) ────────────────────────────────────────────────────
# OPTIONAL — set to True to use S3-compatible object storage for media files
USE_S3=False

# Required only when USE_S3=True:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=        # leave blank for AWS; set for MinIO / Cloudflare R2
