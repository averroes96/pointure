# ── ShoeDZ / Pointure — Self-Hosted (On-Premise) Environment Variables ────────
# Copy to .env.local, fill in every value, then run:
#   docker compose -f docker-compose.local.yml up -d --build

# ── Django ──────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=change-me-generate-with-python-secrets-token-hex-50
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,172.31.3.172
CORS_ALLOWED_ORIGINS=http://localhost

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=shodz
DB_USER=shodz
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
DB_PASSWORD=change-me-strong-password
DATABASE_URL=postgres://shodz:change-me-strong-password@db:5432/shodz

# ── Redis ────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(16))"
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# ── Email ─────────────────────────────────────────────────────────────────────
# Can be left blank to use console backend (prints to Docker logs)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=ShoeDZ <noreply@localhost>

# ── Deployment mode (do not change for self-hosted) ──────────────────────────
DEPLOYMENT_MODE=local

# ── License ───────────────────────────────────────────────────────────────────
# Your ShoeDZ license key (SHDZ-XXXX-XXXX-XXXX)
LICENSE_KEY=SHDZ-XXXX-XXXX-XXXX
# License server URL — leave as-is unless you run your own mirror
LICENSE_SERVER_URL=https://licenses.shodz.app
