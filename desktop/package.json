{
  "name": "shoedz-desktop",
  "version": "1.3.4",
  "description": "ShoeDZ / Pointure - Desktop Edition for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --publish never"
  },
  "keywords": [
    "shoedz",
    "pointure",
    "pos",
    "retail",
    "inventory"
  ],
  "author": "ShoeDZ Team",
  "license": "Proprietary",
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.8.9",
    "get-port": "^7.1.0",
    "wait-on": "^7.2.0"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.shoedz.desktop",
    "productName": "ShoeDZ",
    "copyright": "Copyright © 2026 ShoeDZ",
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "averroes96",
      "repo": "pointure",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer.nsh",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "python-dist/",
        "to": "python"
      },
      {
        "from": "backend-dist/",
        "to": "backend"
      }
    ]
  }
}
