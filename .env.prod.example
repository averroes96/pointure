# ── ShoeDZ / Pointure — Production (Cloud/SaaS) Environment Variables ────────
# Copy to .env.prod, fill in every value, then run:
#   docker compose -f docker-compose.prod.yml up -d

# ── Django ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-generate-with-python-secrets-token-hex-50
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=shodz
DB_USER=shodz
DB_PASSWORD=change-me-strong-password
DATABASE_URL=postgres://shodz:change-me-strong-password@db:5432/shodz

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@yourdomain.com
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=ShoeDZ <noreply@yourdomain.com>

# ── Deployment mode ───────────────────────────────────────────────────────────
# "cloud" disables license checking (SaaS mode).
# "local" enables license enforcement (self-hosted mode).
DEPLOYMENT_MODE=cloud

# ── Cloud Storage (optional — remove if not using S3-compatible storage) ─────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=
# USE_S3=False

# Error monitoring (optional — leave blank to disable)
SENTRY_DSN=

# ── Cloud Storage (media files) ───────────────────────────────────────────────
STORAGE_PROVIDER=aws              # aws | cloudflare | backblaze | gcs | azure
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=eu-west-1
STORAGE_ENDPOINT_URL=             # empty=AWS; R2: https://{id}.r2.cloudflarestorage.com
STORAGE_CDN_DOMAIN=               # optional

# ── Database Backup ───────────────────────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
BACKUP_BUCKET=
BACKUP_REGION=auto
BACKUP_ENDPOINT_URL=
BACKUP_RETENTION_DAYS=30
